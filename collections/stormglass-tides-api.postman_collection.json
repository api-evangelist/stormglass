        {
          "id": "0deda967-5daa-45c9-9372-960bfd87f8ca",
          "name": "Get Tide Extremes",
          "request": {
            "name": "Get Tide Extremes",
            "description": {
              "content": "Retrieve information about high and low tide extremes for a single coordinate. Returns tide high and low events with timestamps and heights. If no datum is specified, values are relative to Mean Sea Level (MSL).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tide",
                "extremes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<float>",
                  "description": "(Required) Latitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<float>",
                  "description": "(Required) Longitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Timestamp in UTC for start of time range"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "Timestamp in UTC for end of time range"
                },
                {
                  "disabled": false,
                  "key": "datum",
                  "value": "<string>",
                  "description": "Datum relative to which values will be reported. Either MLLW or MSL."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
