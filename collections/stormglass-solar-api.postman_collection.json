              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<float>",
                  "description": "(Required) Latitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<float>",
                  "description": "(Required) Longitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "params",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of solar parameters. E.g. uvIndex,downwardShortWaveRadiationFlux"
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Timestamp in UTC for first data hour"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "Timestamp in UTC for last data hour"
                },
                {
                  "disabled": false,
