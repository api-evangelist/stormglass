                  "description": "(Required) Latitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<float>",
                  "description": "(Required) Longitude of the desired coordinate"
                },
                {
                  "disabled": false,
                  "key": "params",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of marine parameters to retrieve"
                },
                {
                  "disabled": false,
                  "key": "start",
